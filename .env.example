APP_ENV=production
APP_URL=https://privatejetexecutive.com
APP_TIMEZONE=Asia/Jakarta

# Populate these only outside the public web root.
SMTP_HOST=mail.jasatiketmurah.com
SMTP_PORT=465
SMTP_USERNAME=charter@privatejetexecutive.com
SMTP_PASSWORD=change-me
SMTP_ENCRYPTION=ssl

MAIL_FROM=noreply@privatejetexecutive.com
MAIL_FROM_NAME=Private Jet Executive
MAIL_REPLY_TO=charter@privatejetexecutive.com
MAIL_BCC_1=jasatiketmurah@gmail.com
MAIL_BCC_2=charter@privatejetexecutive.com

# Invoice administration and MySQL/MariaDB. Keep real values outside public_html.
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=privatejetexecutive
DB_USERNAME=replace-with-database-user
DB_PASSWORD=change-me
ADMIN_USERNAME=invoice-admin
# Generate with: php -r "echo password_hash('choose-a-strong-password', PASSWORD_DEFAULT), PHP_EOL;"
ADMIN_PASSWORD_HASH=replace-with-password-hash
